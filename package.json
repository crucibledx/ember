{
  "name": "@crucibledx/ember-poc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "POC: rebuild coding-harness agent hierarchies from local session files and export them as OTLP traces",
  "scripts": {
    "scan": "bun run src/main.ts",
    "verify": "bun run scripts/verify-tempo.ts",
    "test": "bun test src/",
    "typecheck": "bun node_modules/typescript/lib/tsc.js --noEmit -p .",
    "format": "bun node_modules/prettier/bin/prettier.cjs --write src/ scripts/",
    "format:check": "bun node_modules/prettier/bin/prettier.cjs --check src/ scripts/"
  },
  "dependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "prettier": "^3.10.0",
    "typescript": "^7.0.2"
  }
}
